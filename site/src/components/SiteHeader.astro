---
import Wordmark from './Wordmark.astro';
import ExternalLink from './ExternalLink.astro';

interface Props {
  /* The page this header sits on, for aria-current and the drawn state. */
  current?: 'home' | 'docs' | 'disclosures' | null;
}
const { current = null } = Astro.props;
---

<header class="site-header">
  <div class="wrap site-header__row">
    <a class="brand" href="/" aria-current={current === 'home' ? 'page' : undefined}>
      <Wordmark />
      <span class="brand__name">SuperDirectory</span>
    </a>
    <nav class="site-nav" aria-label="Site">
      <ul>
        <li><a href="/docs/" aria-current={current === 'docs' ? 'page' : undefined}>Docs</a></li>
        <li><ExternalLink href="https://github.com/ozzyphantom/SuperDirectory">GitHub</ExternalLink></li>
      </ul>
    </nav>
  </div>
</header>

<style is:global>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .site-header__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-2);
  }

  /* The product name. A navigation control, so it gets the same hover
     and press as the nav items beside it. */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--target);
    padding-inline: var(--space-2);
    margin-inline-start: calc(-1 * var(--space-2));
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
    border-radius: var(--radius-control);
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Navigation items: no underline at rest, a fill on hover, a press on
     click. The current page is marked with a heavy underline. */
  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding-inline: var(--space-3);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-control);
  }
  .brand:hover,
  .site-nav a:hover {
    background: var(--well);
  }
  .brand:active,
  .site-nav a:active {
    background: var(--rule);
    transform: translateY(1px);
  }
  .site-nav a[aria-current='page'] {
    text-decoration-line: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.4em;
  }

  /* A phone: tighter type and padding keep the name and the navigation on
     one row. Targets stay 44px tall. */
  @media (max-width: 30em) {
    .brand {
      gap: var(--space-2);
      font-size: 1rem;
    }
    .brand .mark {
      width: 1.25rem;
      height: 1.25rem;
    }
    .site-nav a {
      padding-inline: var(--space-2);
    }
  }
</style>
